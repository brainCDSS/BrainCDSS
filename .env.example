# Django execution mode; local is the safe development default.
DJANGO_SETTINGS_MODULE=config.settings.local
# Replace locally; never commit a functioning secret.
DJANGO_SECRET_KEY=TODO_REPLACE_WITH_LOCAL_ONLY_VALUE
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL application database.
POSTGRES_DB=brainon
POSTGRES_USER=brainon
POSTGRES_PASSWORD=TODO_LOCAL_DATABASE_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# RabbitMQ is the only Celery broker in this architecture.
RABBITMQ_DEFAULT_USER=brainon
RABBITMQ_DEFAULT_PASS=TODO_LOCAL_RABBITMQ_PASSWORD
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
CELERY_BROKER_URL=amqp://brainon:TODO_LOCAL_RABBITMQ_PASSWORD@rabbitmq:5672//
# Results are disabled by default; task business state belongs in PostgreSQL tables.
CELERY_RESULT_BACKEND=

# Internal Service JWT for CDS Hooks and service-to-service APIs.
# Never commit a functioning signing key.
SERVICE_JWT_SIGNING_KEY=TODO_REPLACE_WITH_SERVICE_JWT_SECRET
SERVICE_JWT_ALGORITHM=HS256
SERVICE_JWT_ISSUER=brainon-internal
SERVICE_JWT_AUDIENCE=brainon-django-internal

# Public/internal service origins.
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
INFERENCE_API_URL=http://inference-api:8100
ASSISTANT_SERVICE_URL=http://assistant-service:8200
MCP_SERVER_URL=http://mcp-server:8300
MCP_BACKEND_TOKEN=TODO_INTERNAL_READ_ONLY_TOKEN

# DICOMweb viewers and archive; placeholders only.
ORTHANC_URL=http://orthanc:8042
ORTHANC_USERNAME=brainon
ORTHANC_PASSWORD=TODO_LOCAL_ORTHANC_PASSWORD
OHIF_URL=http://localhost:3000

# Model bundle locations and experiment metadata.
GCS_MODEL_BUCKET=TODO_BUCKET_NAME
MLFLOW_TRACKING_URI=http://mlflow:5000
MODEL_BUNDLE_URI=

# External Gemini API; leave blank to select deterministic mock provider.
GEMINI_API_KEY=
GEMINI_MODEL=TODO_APPROVED_MODEL

# Firebase Cloud Messaging; no key files belong in this repository.
FCM_PROJECT_ID=TODO_PROJECT_ID
FCM_CREDENTIALS_PATH=

# Korean public medication data APIs.
DUR_API_BASE_URL=TODO_DUR_ENDPOINT
DUR_API_KEY=
DRUG_APPROVAL_API_BASE_URL=TODO_APPROVAL_ENDPOINT
DRUG_APPROVAL_API_KEY=

# OpenTelemetry export and application logging.
OTEL_SERVICE_NAME=brainon-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
LOG_LEVEL=INFO
