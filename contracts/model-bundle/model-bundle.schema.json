{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brainon/model-bundle/v1",
  "type": "object",
  "required": ["schema_version", "bundle_id", "model_name", "analysis_type", "framework", "gcs_prefix", "checkpoint", "trainer", "nnunet", "inputs", "labels", "preprocessing", "postprocessing", "output_types", "files", "readiness"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "bundle_id": {"type": "string"},
    "model_name": {"type": "string"},
    "analysis_type": {"enum": ["HEMORRHAGIC_STROKE_CT", "ISCHEMIC_STROKE_DWI_ADC", "CEREBRAL_ANEURYSM_MRA"]},
    "framework": {"const": "nnunetv2"},
    "framework_version": {"type": ["string", "null"]},
    "source_experiment": {"type": "string"},
    "source_repository": {"type": "string"},
    "source_git_commit": {"type": "string"},
    "source_config": {"type": "string"},
    "gcs_prefix": {"type": "string", "pattern": "^gs://"},
    "checkpoint": {"type": "string"},
    "trainer": {"type": "object"},
    "nnunet": {"type": "object"},
    "inputs": {"type": "object"},
    "labels": {"type": "object"},
    "preprocessing": {"type": "object"},
    "postprocessing": {"type": "object"},
    "output_types": {"type": "array", "items": {"enum": ["NIFTI_MASK", "RESULT_JSON", "DICOM_SEG", "DICOM_SR"]}},
    "mlflow": {"type": "object"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "readiness": {"type": "object"}
  },
  "additionalProperties": false
}
