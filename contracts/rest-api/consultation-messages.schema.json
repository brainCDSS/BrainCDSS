{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brainon/consultation-messages/v1",
  "title": "Consultation message collection response",
  "type": "object",
  "required": ["results", "next_cursor", "has_more", "presence"],
  "properties": {
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/message" },
      "maxItems": 100
    },
    "next_cursor": {
      "oneOf": [
        { "type": "string", "format": "uuid" },
        { "type": "null" }
      ]
    },
    "has_more": { "type": "boolean" },
    "presence": { "$ref": "#/$defs/presence" }
  },
  "additionalProperties": false,
  "$defs": {
    "presence": { "type": "object", "required": ["participant_count", "active_count", "participants"], "properties": { "participant_count": {"type":"integer"}, "active_count": {"type":"integer"}, "participants": {"type":"array", "items": {"type":"object", "required":["id","name","department","is_online","is_typing","is_mine"], "properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string"},"department":{"oneOf":[{"type":"string"},{"type":"null"}]},"is_online":{"type":"boolean"},"is_typing":{"type":"boolean"},"is_mine":{"type":"boolean"}}, "additionalProperties":false}} }, "additionalProperties": false },
    "clinician": {
      "type": "object",
      "required": ["id", "name", "department"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "department": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "required": [
        "message_id",
        "consultation_id",
        "sender",
        "content",
        "created_at",
        "is_mine"
      ],
      "properties": {
        "message_id": { "type": "string", "format": "uuid" },
        "consultation_id": { "type": "string", "format": "uuid" },
        "sender": { "$ref": "#/$defs/clinician" },
        "content": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "created_at": { "type": "string", "format": "date-time" },
        "is_mine": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
