[Unit]
Description=BrainOn Runtime Service JWT Guard
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/brainon-service-jwt-guard.sh
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
