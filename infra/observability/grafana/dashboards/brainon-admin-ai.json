      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#DC2626"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 50,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "brainon-postgres"
          },
          "format": "time_series",
          "rawSql": "\nSELECT\n    $__timeGroupAlias(\n        requested_at,\n        '1h'\n    ),\n    COUNT(*)::double precision\n        AS \"실패\"\nFROM ai_aianalysis\nWHERE\n    $__timeFilter(requested_at)\n    AND status IN (\n        'FAILED',\n        'ERROR',\n        'TIMEOUT',\n        'CANCELLED'\n    )\nGROUP BY 1\nORDER BY 1\n"
        }
      ],
      "description": "실제 AIAnalysis 실패 상태의 시간대별 발생 추이.",
      "transparent": false
    }
  ],
