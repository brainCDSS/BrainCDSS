  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "AI 분석 건수",
      "datasource": {
        "type": "postgres",
        "uid": "brainon-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#7C3AED"
          },
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "brainon-postgres"
          },
          "format": "table",
          "rawSql": "\nSELECT\n    COUNT(*) FILTER (\n        WHERE $__timeFilter(requested_at)\n    )::bigint AS \"선택 범위\",\n\n    COUNT(*) FILTER (\n        WHERE\n            (requested_at AT TIME ZONE 'Asia/Seoul')::date\n            =\n            (NOW() AT TIME ZONE 'Asia/Seoul')::date\n    )::bigint AS \"오늘\",\n\n    COUNT(*) FILTER (\n        WHERE\n            $__timeFilter(requested_at)\n            AND status IN (\n                'FAILED',\n                'ERROR',\n                'TIMEOUT',\n                'CANCELLED'\n            )\n    )::bigint AS \"실패\"\nFROM ai_aianalysis\n"
        }
      ],
      "description": "실제 AIAnalysis 기준 선택 기간/오늘/실패 건수.",
      "transparent": false
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "AI 성공률",
      "datasource": {
        "type": "postgres",
        "uid": "brainon-postgres"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#DC2626",
                "value": null
              },
              {
                "color": "#D97706",
                "value": 70
              },
              {
                "color": "#059669",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "minVizHeight": 75,
        "minVizWidth": 75
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "brainon-postgres"
          },
          "format": "table",
          "rawSql": "\nSELECT\n    CASE\n        WHEN COUNT(*) FILTER (\n            WHERE\n                status IN ('COMPLETED', 'FAILED')\n                AND $__timeFilter(requested_at)\n        ) = 0\n        THEN NULL\n\n        ELSE ROUND(\n            (\n                100.0\n                * COUNT(*) FILTER (\n                    WHERE\n                        status = 'COMPLETED'\n                        AND $__timeFilter(requested_at)\n                )\n                /\n                NULLIF(\n                    COUNT(*) FILTER (\n                        WHERE\n                            status IN ('COMPLETED', 'FAILED')\n                            AND $__timeFilter(requested_at)\n                    ),\n                    0\n                )\n            ),\n            1\n        )\n    END AS \"성공률\"\nFROM ai_aianalysis\n"
        }
      ],
      "description": "선택 기간의 종료 상태 COMPLETED/FAILED 중 COMPLETED 비율.",
      "transparent": false
    },
    {
