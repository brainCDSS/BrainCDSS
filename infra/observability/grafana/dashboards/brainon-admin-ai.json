    {
      "id": 4,
      "type": "bargauge",
      "title": "AI 처리 현황",
      "datasource": {
        "type": "postgres",
        "uid": "brainon-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizHeight": 12,
        "minVizWidth": 8,
        "valueMode": "color",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "brainon-postgres"
          },
          "format": "table",
          "rawSql": "\nSELECT\n    COUNT(*) FILTER (\n        WHERE status = 'COMPLETED'\n    )::bigint AS \"완료\",\n\n    COUNT(*) FILTER (\n        WHERE status IN (\n            'FAILED',\n            'ERROR',\n            'TIMEOUT',\n            'CANCELLED'\n        )\n    )::bigint AS \"실패\",\n\n    COUNT(*) FILTER (\n        WHERE status IN (\n            'PROCESSING',\n            'RUNNING',\n            'IN_PROGRESS'\n        )\n    )::bigint AS \"처리 중\",\n\n    COUNT(*) FILTER (\n        WHERE status IN (\n            'PENDING',\n            'QUEUED',\n            'REQUESTED'\n        )\n    )::bigint AS \"대기\"\nFROM ai_aianalysis\nWHERE $__timeFilter(requested_at)\n"
        }
      ],
      "description": "현재 선택 기간의 AIAnalysis 상태를 운영 그룹별로 집계.",
      "transparent": false
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "AI 실패 추이",
      "datasource": {
        "type": "postgres",
        "uid": "brainon-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
