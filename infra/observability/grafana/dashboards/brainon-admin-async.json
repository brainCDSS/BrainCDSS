          "format": "table",
          "rawSql": "\nSELECT\n    created_at AS \"발생 시각\",\n    event_type AS \"이벤트\",\n    aggregate_type AS \"대상\",\n    status AS \"상태\",\n    retry_count AS \"재시도\",\n    published_at AS \"발행 시각\"\nFROM common_outboxevent\nWHERE $__timeFilter(created_at)\nORDER BY created_at DESC\nLIMIT 50\n"
        }
      ],
      "description": "최근 Outbox 이벤트 처리 내역.",
      "transparent": false
    },
