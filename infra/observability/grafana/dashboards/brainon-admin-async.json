    {
      "id": 7,
      "type": "timeseries",
      "title": "비동기 이벤트 처리 추이",
      "datasource": {
        "type": "postgres",
        "uid": "brainon-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "brainon-postgres"
          },
          "format": "time_series",
          "rawSql": "\nSELECT\n    $__timeGroupAlias(\n        created_at,\n        '1h'\n    ),\n\n    COUNT(*) FILTER (\n        WHERE status IN (\n            'PUBLISHED',\n            'COMPLETED',\n            'SUCCESS'\n        )\n    )::double precision AS \"발행 완료\",\n\n    COUNT(*) FILTER (\n        WHERE status IN (\n            'PENDING',\n            'QUEUED',\n            'READY'\n        )\n    )::double precision AS \"대기\",\n\n    COUNT(*) FILTER (\n        WHERE status IN (\n            'FAILED',\n            'ERROR'\n        )\n    )::double precision AS \"실패\"\n\nFROM common_outboxevent\nWHERE $__timeFilter(created_at)\nGROUP BY 1\nORDER BY 1\n"
        }
      ],
      "description": "OutboxEvent를 기준으로 한 비동기 이벤트 처리 상태 추이.",
      "transparent": false
    },
