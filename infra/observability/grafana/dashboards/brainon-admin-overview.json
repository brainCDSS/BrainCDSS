        "query": "label_values({host=\"braincdss-rabbitmq\"}, container)",
        "definition": "label_values({host=\"braincdss-rabbitmq\"}, container)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
