        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "brainon-postgres"
          },
          "format": "table",
          "rawSql": "\nSELECT\n    (\n        (\n            SELECT COUNT(*)\n            FROM audit_auditlog\n            WHERE\n                $__timeFilter(occurred_at)\n                AND COALESCE(\n                    outcome,\n                    'UNKNOWN'\n                ) NOT IN (\n                    'SUCCESS',\n                    'SUCCEEDED',\n                    'COMPLETED',\n                    'OK'\n                )\n        )\n        +\n        (\n            SELECT COUNT(*)\n            FROM ai_aianalysis\n            WHERE\n                $__timeFilter(requested_at)\n                AND status IN (\n                    'FAILED',\n                    'ERROR',\n                    'TIMEOUT',\n                    'CANCELLED'\n                )\n        )\n    )::bigint AS \"전체\",\n\n    (\n        SELECT COUNT(*)\n        FROM audit_auditlog\n        WHERE\n            $__timeFilter(occurred_at)\n            AND COALESCE(\n                outcome,\n                'UNKNOWN'\n            ) NOT IN (\n                'SUCCESS',\n                'SUCCEEDED',\n                'COMPLETED',\n                'OK'\n            )\n    )::bigint AS \"감사\",\n\n    (\n        SELECT COUNT(*)\n        FROM ai_aianalysis\n        WHERE\n            $__timeFilter(requested_at)\n            AND status IN (\n                'FAILED',\n                'ERROR',\n                'TIMEOUT',\n                'CANCELLED'\n            )\n    )::bigint AS \"AI\"\n"
        }
      ],
      "description": "HTTP 장애뿐 아니라 Audit WARNING, AI 실패, 내부 dependency partial failure까지 운영 확인 대상으로 집계합니다.",
      "transparent": false
    },
