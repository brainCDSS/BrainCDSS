    {
      "id": 8,
      "type": "row",
      "title": "02. Account / Database",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "table",
      "title": "Users by Role",
      "datasource": {
        "type": "postgres",
        "uid": "brainon-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "brainon-postgres"
          },
          "format": "table",
          "rawSql": "\n    SELECT\n        role_code,\n        COUNT(*) AS total,\n        COUNT(*) FILTER (\n            WHERE is_active = TRUE\n        ) AS active,\n        COUNT(*) FILTER (\n            WHERE is_active = FALSE\n        ) AS inactive\n    FROM monitoring.user_account\n    GROUP BY role_code\n    ORDER BY role_code\n    "
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "DB Session State",
      "datasource": {
        "type": "postgres",
        "uid": "brainon-postgres"
      },
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "brainon-postgres"
          },
          "format": "table",
          "rawSql": "\n    SELECT\n        COALESCE(\n            state,\n            'UNKNOWN'\n        ) AS state,\n        COUNT(*) AS sessions\n    FROM pg_stat_activity\n    WHERE datname = current_database()\n    GROUP BY state\n    ORDER BY sessions DESC\n    "
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Audit Outcomes · 24h",
      "datasource": {
        "type": "postgres",
        "uid": "brainon-postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "brainon-postgres"
          },
          "format": "table",
          "rawSql": "\n    SELECT\n        COALESCE(\n            outcome,\n            'UNKNOWN'\n        ) AS outcome,\n        COUNT(*) AS events\n    FROM monitoring.audit_log\n    WHERE occurred_at\n        >= NOW() - INTERVAL '24 hours'\n    GROUP BY outcome\n    ORDER BY events DESC\n    "
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "03. System Activity",
      "collapsed": false,
