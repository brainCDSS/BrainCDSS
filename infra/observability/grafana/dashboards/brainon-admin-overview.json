          "rawSql": "\n    SELECT\n        started_at AS time,\n        trace,\n        standard,\n        direction,\n        source_system,\n        target_system,\n        message_type,\n        status,\n        attempt_count,\n        error_code,\n        completed_at\n    FROM monitoring.integration_transaction\n    WHERE (\n        NULLIF(\n            ${request_id:sqlstring},\n            ''\n        ) IS NULL\n        OR trace\n            = ${request_id:sqlstring}\n    )\n      AND $__timeFilter(\n            started_at\n          )\n    ORDER BY started_at ASC\n    LIMIT 500\n    "
