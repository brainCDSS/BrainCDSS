      "type": "logs",
      "title": "Backend / Celery / RabbitMQ / Assistant / MCP Errors",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{\n      host=\"braincdss-rabbitmq\",\n      container=~\"$runtime_container\"\n    }\n    |~ \"(?i)(error|exception|failed|failure|critical|timeout|traceback)\"",
          "queryType": "range",
          "editorMode": "code"
