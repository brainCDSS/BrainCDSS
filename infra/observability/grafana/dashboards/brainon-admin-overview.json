    {
      "id": 1,
      "type": "stat",
      "title": "전체 사용자",
      "datasource": {
        "type": "postgres",
        "uid": "brainon-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#2563EB"
          },
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "brainon-postgres"
          },
          "format": "table",
          "rawSql": "\nSELECT\n    COUNT(*)::bigint AS \"전체\",\n    COUNT(*) FILTER (\n        WHERE is_active = TRUE\n    )::bigint AS \"활성\",\n    COUNT(*) FILTER (\n        WHERE\n            (created_at AT TIME ZONE 'Asia/Seoul')::date\n            =\n            (NOW() AT TIME ZONE 'Asia/Seoul')::date\n    )::bigint AS \"오늘 신규\"\nFROM accounts_user\n"
        }
      ],
      "description": "BrainOn 사용자 계정 현황. 전체/활성/오늘 신규 계정을 실제 DB에서 집계.",
      "transparent": false
    },
