    {
      "id": 21,
      "type": "table",
      "title": "AuditLog Trace",
      "datasource": {
        "type": "postgres",
        "uid": "brainon-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "brainon-postgres"
          },
          "format": "table",
          "rawSql": "\n    SELECT\n        occurred_at AS time,\n        request_id,\n        source_service,\n        actor_role_code,\n        action,\n        resource_type,\n        resource_id,\n        outcome\n    FROM monitoring.audit_log\n    WHERE (\n        NULLIF(\n            ${request_id:sqlstring},\n            ''\n        ) IS NULL\n        OR request_id::text\n            = ${request_id:sqlstring}\n    )\n      AND $__timeFilter(\n            occurred_at\n          )\n    ORDER BY occurred_at ASC\n    LIMIT 500\n    "
        }
      ]
    },
    {
      "id": 22,
      "type": "table",
      "title": "Integration Trace",
      "datasource": {
        "type": "postgres",
        "uid": "brainon-postgres"
      },
      "gridPos": {
