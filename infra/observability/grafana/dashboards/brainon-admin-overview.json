          "rawSql": "\nSELECT *\nFROM (\n    SELECT\n        occurred_at AS \"발생 시각\",\n        'Audit'::text AS \"구분\",\n        source_service AS \"서비스\",\n        action AS \"이벤트\",\n        outcome AS \"상태\",\n        COALESCE(\n            reason,\n            '-'\n        ) AS \"상세\",\n        COALESCE(\n            request_id::text,\n            '-'\n        ) AS \"추적 ID\"\n\n    FROM audit_auditlog\n\n    WHERE\n        $__timeFilter(occurred_at)\n        AND COALESCE(\n            outcome,\n            'UNKNOWN'\n        ) NOT IN (\n            'SUCCESS',\n            'SUCCEEDED',\n            'COMPLETED',\n            'OK'\n        )\n\n    UNION ALL\n\n    SELECT\n        requested_at AS \"발생 시각\",\n        'AI'::text AS \"구분\",\n        'AI Inference'::text AS \"서비스\",\n        analysis_type AS \"이벤트\",\n        status AS \"상태\",\n        COALESCE(\n            failure_code,\n            '-'\n        ) AS \"상세\",\n        COALESCE(\n            trace_id,\n            '-'\n        ) AS \"추적 ID\"\n\n    FROM ai_aianalysis\n\n    WHERE\n        $__timeFilter(requested_at)\n        AND status IN (\n            'FAILED',\n            'ERROR',\n            'TIMEOUT',\n            'CANCELLED'\n        )\n) incidents\n\nORDER BY \"발생 시각\" DESC\nLIMIT 50\n"
        }
      ],
      "description": "최근 Audit/AI 이상 이벤트를 한 화면에서 확인.",
      "transparent": false
    }
  ],
