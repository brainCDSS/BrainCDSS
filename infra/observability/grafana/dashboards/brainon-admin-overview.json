    },
    {
      "id": 16,
      "type": "table",
      "title": "Recent SYSTEM_ADMIN Actions",
      "datasource": {
        "type": "postgres",
        "uid": "brainon-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "brainon-postgres"
          },
          "format": "table",
          "rawSql": "\n    SELECT\n        occurred_at AS time,\n        request_id,\n        source_service,\n        action,\n        resource_type,\n        resource_id,\n        outcome\n    FROM monitoring.audit_log\n    WHERE actor_role_code = 'SYSTEM_ADMIN'\n      AND $__timeFilter(\n            occurred_at\n          )\n    ORDER BY occurred_at DESC\n    LIMIT 200\n    "
        }
      ]
    },
    {
      "id": 17,
      "type": "table",
      "title": "Recent Integration Transactions",
      "datasource": {
        "type": "postgres",
        "uid": "brainon-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "brainon-postgres"
          },
          "format": "table",
          "rawSql": "\n    SELECT\n        started_at AS time,\n        trace,\n        standard,\n        direction,\n        source_system,\n        target_system,\n        message_type,\n        status,\n        attempt_count,\n        error_code\n    FROM monitoring.integration_transaction\n    WHERE $__timeFilter(\n        started_at\n    )\n    ORDER BY started_at DESC\n    LIMIT 200\n    "
        }
      ]
    },
    {
      "id": 18,
