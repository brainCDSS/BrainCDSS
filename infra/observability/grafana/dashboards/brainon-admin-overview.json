    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Audit Activity by Service",
      "datasource": {
        "type": "postgres",
        "uid": "brainon-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "brainon-postgres"
          },
          "format": "time_series",
          "rawSql": "\n    SELECT\n        $__timeGroupAlias(\n            occurred_at,\n            '5m'\n        ),\n        COALESCE(\n            source_service,\n            'unknown'\n        ) AS metric,\n        COUNT(*)::double precision\n            AS value\n    FROM monitoring.audit_log\n    WHERE $__timeFilter(\n        occurred_at\n    )\n    GROUP BY 1, 2\n    ORDER BY 1\n    "
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Runtime Log Volume by Container",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (container) (\n      count_over_time(\n        {\n          host=\"braincdss-rabbitmq\",\n          container=~\"$runtime_container\"\n        }[$__interval]\n      )\n    )",
          "queryType": "range",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 15,
      "type": "row",
      "title": "04. Admin / Integration Audit",
